# One origin for everything: the SPA and the API share a hostname, so the
# browser makes same-origin requests. That removes CORS from the picture
# entirely — the class of failure that cost the most time on the PaaS setup.
#
# SITE_ADDRESS comes from .env. Give it a hostname (not an IP) and Caddy
# obtains and renews a Let's Encrypt certificate on its own.
{$SITE_ADDRESS} {
	encode gzip zstd

	# API first — most specific wins in Caddy regardless of order, but reading
	# order matters to the next person.
	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		root * /srv
		# Client-side routing: every unknown path is the app, not a 404.
		try_files {path} /index.html
		file_server
	}

	# DO NOT ADD A ROUTE FOR UPLOADED PHOTOS.
	#
	# Profile photos live on the `uploads` volume, mounted on the api container
	# and deliberately not on this one, so there is nothing here to serve even
	# by accident. Mounting it and adding `handle /uploads/*` would make every
	# photo readable by anyone holding the filename, with no authorization
	# anywhere in the path — including a photograph of a child, which
	# GET /api/players/:id/photo restricts to their coach and a consented
	# guardian. If "just serve the images directly, it's faster" is ever
	# proposed, this comment is the answer.

	header {
		# Strict-Transport-Security is deliberately NOT here yet. An earlier
		# comment said Caddy adds it by itself; it does not, and the header was
		# never sent. Turning it on pins every visiting browser to HTTPS for
		# max-age, which is the right thing to do for the permanent domain and
		# the wrong thing to do on a throwaway sslip.io name. DOMAIN.md step 3
		# says when and how. These three are set explicitly:
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
